<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>海盜船長的「因數」藏寶圖｜小四數學互動遊戲</title>
  <style>
    :root {
      --ocean-dark: #0c4a6e;
      --ocean-main: #0284c7;
      --ocean-light: #e0f2fe;
      --sand-bg: #fef9c3;
      --sand-card: #fffbeb;
      --amber-main: #d97706;
      --amber-border: #f59e0b;
      --emerald-main: #059669;
      --emerald-light: #d1fae5;
      --rose-main: #e11d48;
      --rose-light: #ffe4e6;
      --text-dark: #1e293b;
      --text-muted: #64748b;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      font-family: "PingFang TC", "Microsoft JhengHei", "Noto Sans TC", system-ui, sans-serif;
      background: linear-gradient(135deg, #0c4a6e 0%, #0369a1 45%, #155e75 100%);
      color: var(--text-dark);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 12px;
      overflow-x: hidden;
    }

    #confetti-canvas {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 100;
    }

    /* 頂部航海標題列 */
    .header-bar {
      width: 100%;
      max-width: 1220px;
      background: rgba(255, 251, 235, 0.97);
      border: 3px solid #f59e0b;
      border-radius: 22px;
      padding: 10px 18px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
      margin-bottom: 12px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-icon {
      font-size: 38px;
      display: inline-block;
      animation: shipBob 2.8s ease-in-out infinite;
    }

    .brand-title {
      font-size: 20px;
      font-weight: 900;
      color: #78350f;
    }

    .brand-sub {
      font-size: 13px;
      font-weight: 700;
      color: #b45309;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .gem-badge {
      display: flex;
      align-items: center;
      gap: 6px;
      background: #fef3c7;
      border: 2px solid #f59e0b;
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 15px;
      font-weight: 900;
      color: #92400e;
    }

    .home-btn {
      background: #e0f2fe;
      border: 2px solid #38bdf8;
      color: #0369a1;
      font-size: 14px;
      font-weight: 900;
      padding: 7px 14px;
      border-radius: 999px;
      cursor: pointer;
    }
    .home-btn:hover { background: #bae6fd; }

    /* 雙欄主舞台：左側作答區 ＋ 右側手寫草稿紙 */
    .workspace-grid {
      width: 100%;
      max-width: 1220px;
      flex: 1;
      display: grid;
      grid-template-columns: 1.38fr 1fr;
      gap: 14px;
      align-items: stretch;
    }

    /* 左側：藏寶圖題目卡片 */
    .game-card {
      background: #ffffff;
      border: 4px solid #f59e0b;
      border-radius: 26px;
      padding: 18px 20px;
      box-shadow: 0 14px 32px rgba(0, 0, 0, 0.25);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 12px;
      min-width: 0;
    }

    /* 右側：航海草稿畫板 */
    .scratchpad-card {
      background: #fffbeb;
      border: 4px solid #38bdf8;
      border-radius: 26px;
      padding: 14px 16px;
      box-shadow: 0 14px 32px rgba(0, 0, 0, 0.25);
      display: flex;
      flex-direction: column;
      gap: 10px;
      min-height: 520px;
    }

    .pad-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding-bottom: 8px;
      border-bottom: 2px dashed #fcd34d;
    }

    .pad-title {
      font-size: 16px;
      font-weight: 900;
      color: #0369a1;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .pad-tools {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .color-dot {
      width: 24px;
      height: 24px;
      border-radius: 999px;
      border: 2.5px solid #ffffff;
      box-shadow: 0 0 0 1.5px #94a3b8;
      cursor: pointer;
    }
    .color-dot.active {
      box-shadow: 0 0 0 2.5px #0284c7;
      transform: scale(1.12);
    }

    .pad-btn {
      background: #ffffff;
      border: 2px solid #cbd5e1;
      color: #334155;
      font-size: 12px;
      font-weight: 900;
      padding: 4px 10px;
      border-radius: 10px;
      cursor: pointer;
    }
    .pad-btn.active {
      background: #e0f2fe;
      border-color: #0284c7;
      color: #0369a1;
    }
    .pad-btn.clear-pad {
      background: #ffe4e6;
      border-color: #fda4af;
      color: #be123c;
    }

    .canvas-wrapper {
      flex: 1;
      width: 100%;
      position: relative;
      border-radius: 18px;
      border: 2.5px solid #cbd5e1;
      background-color: #ffffff;
      background-image:
        linear-gradient(to right, #f1f5f9 1px, transparent 1px),
        linear-gradient(to bottom, #f1f5f9 1px, transparent 1px);
      background-size: 24px 24px;
      overflow: hidden;
      touch-action: none;
    }

    #scratch-canvas {
      display: block;
      width: 100%;
      height: 100%;
      cursor: crosshair;
      touch-action: none;
    }

    .pad-tip {
      font-size: 12px;
      font-weight: 800;
      color: #92400e;
      text-align: center;
    }

    /* 首頁關卡選擇 */
    .menu-screen {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 16px;
      padding: 10px 4px;
      flex: 1;
    }

    .mode-grid {
      width: 100%;
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .mode-card {
      border-radius: 20px;
      padding: 16px 18px;
      border: 3px solid transparent;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
      gap: 6px;
      transition: transform 0.15s ease;
    }
    .mode-card:hover { transform: translateY(-2px); }
    .mode-card:active { transform: translateY(2px); }

    .m-easy {
      background: #ecfdf5;
      border-color: #34d399;
      border-bottom: 5px solid #059669;
      color: #064e3b;
    }
    .m-mid {
      background: #fffbeb;
      border-color: #fbbf24;
      border-bottom: 5px solid #d97706;
      color: #78350f;
    }
    .m-hard {
      background: #e0f2fe;
      border-color: #38bdf8;
      border-bottom: 5px solid #0284c7;
      color: #0c4a6e;
    }

    .mode-title {
      font-size: 18px;
      font-weight: 900;
    }

    .mode-desc {
      font-size: 14px;
      font-weight: 700;
      opacity: 0.9;
    }

    /* 關卡頂部進度 */
    .stage-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .stage-badge {
      padding: 5px 14px;
      border-radius: 999px;
      font-size: 14px;
      font-weight: 900;
      color: #ffffff;
      background: #d97706;
    }

    .progress-dots {
      display: flex;
      gap: 6px;
      align-items: center;
    }

    .p-dot {
      width: 22px;
      height: 9px;
      border-radius: 999px;
      background: #e2e8f0;
    }
    .p-dot.done { background: #10b981; }
    .p-dot.current { background: #f59e0b; width: 32px; }

    /* 仿課本圖片的「乘法成對框 ＋ 列出所有因數」題目區 */
    .q-title-row {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 22px;
      font-weight: 900;
      color: #0f172a;
    }

    .num-circle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: 999px;
      background: #16a34a;
      color: #ffffff;
      font-size: 17px;
      font-weight: 900;
      flex-shrink: 0;
    }

    .factor-work-area {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      justify-content: space-between;
      gap: 14px;
    }

    /* 淡黃色乘法算式卡片（還原參考圖片設計） */
    .mult-pairs-card {
      flex: 1;
      min-width: 240px;
      background: #fef9c3;
      border: 2.5px solid #fde047;
      border-radius: 18px;
      padding: 14px 18px;
      box-shadow: 0 4px 0 #fde047;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .mult-row {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 22px;
      font-weight: 900;
      color: #1e293b;
    }

    .fixed-num {
      display: inline-block;
      min-width: 28px;
      text-align: center;
      color: #0f172a;
    }

    /* 所有因數列舉區 */
    .list-factors-box {
      background: #f8fafc;
      border: 2.5px solid #cbd5e1;
      border-radius: 18px;
      padding: 12px 16px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .list-factors-flow {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px;
      font-size: 20px;
      font-weight: 900;
      color: #0f172a;
      line-height: 1.8;
    }

    /* 可點擊填寫的數字空格 */
    .blank-box {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 56px;
      height: 44px;
      padding: 0 8px;
      border-radius: 10px;
      border: 3px solid #64748b;
      background: #ffffff;
      font-size: 21px;
      font-weight: 900;
      color: #1e293b;
      cursor: pointer;
      transition: border-color 0.15s ease, background-color 0.15s ease;
    }

    .blank-box.active {
      border-color: #0284c7;
      background: #e0f2fe;
      color: #0369a1;
      box-shadow: 0 0 0 3.5px #7dd3fc;
    }

    .blank-box.correct {
      border-color: #10b981;
      background: #d1fae5;
      color: #065f46;
      box-shadow: none;
    }

    .blank-box.wrong {
      border-color: #f43f5e;
      background: #ffe4e6;
      color: #be123c;
      box-shadow: none;
    }

    /* 迷你數字鍵盤（緊貼乘法區右側） */
    .mini-keypad {
      width: 204px;
      background: #ffffff;
      border: 2.5px solid #f59e0b;
      border-radius: 18px;
      padding: 9px;
      box-shadow: 0 8px 18px rgba(217, 119, 6, 0.15);
      flex-shrink: 0;
    }

    .keypad-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 6px;
      padding: 0 3px;
    }

    .keypad-label {
      font-size: 12px;
      font-weight: 900;
      color: #92400e;
    }

    .keypad-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 4px;
      margin-bottom: 6px;
    }

    .key-btn {
      height: 36px;
      border-radius: 9px;
      border: none;
      border-bottom: 3px solid #cbd5e1;
      background: #f1f5f9;
      color: #1e293b;
      font-size: 17px;
      font-weight: 900;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .key-btn:active {
      transform: translateY(2px);
      border-bottom-width: 1px;
    }

    .keypad-actions {
      display: grid;
      grid-template-columns: 1fr 1.35fr;
      gap: 5px;
    }

    .key-clear {
      height: 34px;
      border-radius: 9px;
      border: none;
      border-bottom: 3px solid #fda4af;
      background: #ffe4e6;
      color: #be123c;
      font-size: 13px;
      font-weight: 900;
      cursor: pointer;
    }

    .key-submit {
      height: 34px;
      border-radius: 9px;
      border: none;
      border-bottom: 3px solid #b45309;
      background: #f59e0b;
      color: #ffffff;
      font-size: 13px;
      font-weight: 900;
      cursor: pointer;
    }
    .key-clear:active, .key-submit:active {
      transform: translateY(2px);
      border-bottom-width: 1px;
    }

    .helper-bar {
      font-size: 13px;
      font-weight: 800;
      color: #0369a1;
      background: #e0f2fe;
      border: 1.5px solid #bae6fd;
      padding: 6px 12px;
      border-radius: 12px;
    }

    /* 回饋橫幅 */
    .feedback-banner {
      width: 100%;
      border-radius: 16px;
      padding: 10px 16px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .feedback-banner.wrong {
      background: #ffe4e6;
      border: 2.5px solid #fda4af;
      color: #9f1239;
      justify-content: center;
      font-size: 14px;
      font-weight: 900;
    }

    .feedback-banner.correct {
      background: #d1fae5;
      border: 3px solid #34d399;
      color: #064e3b;
      font-size: 15px;
      font-weight: 900;
    }

    .next-btn {
      background: #059669;
      border: none;
      border-bottom: 4px solid #064e3b;
      color: #ffffff;
      font-size: 15px;
      font-weight: 900;
      padding: 8px 18px;
      border-radius: 12px;
      cursor: pointer;
    }
    .next-btn:active {
      transform: translateY(3px);
      border-bottom-width: 1px;
    }

    /* 結算畫面 */
    .result-box {
      text-align: center;
      padding: 22px;
      background: linear-gradient(180deg, #fef9c3 0%, #d1fae5 100%);
      border: 4px dashed #f59e0b;
      border-radius: 22px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
    }

    .action-pill-btn {
      background: linear-gradient(180deg, #f59e0b 0%, #d97706 100%);
      border: none;
      border-bottom: 4px solid #78350f;
      color: #ffffff;
      font-size: 16px;
      font-weight: 900;
      padding: 11px 22px;
      border-radius: 14px;
      cursor: pointer;
    }
    .action-pill-btn.secondary {
      background: linear-gradient(180deg, #0ea5e9 0%, #0284c7 100%);
      border-bottom-color: #0c4a6e;
    }

    @keyframes shipBob {
      0%, 100% { transform: translateY(0) rotate(-3deg); }
      50% { transform: translateY(-5px) rotate(3deg); }
    }
    @keyframes shakeSide {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-6px); }
      50% { transform: translateX(6px); }
      75% { transform: translateX(-4px); }
    }

    @media (max-width: 920px) {
      .workspace-grid {
        grid-template-columns: 1fr;
      }
      .scratchpad-card {
        min-height: 300px;
      }
    }
  </style>
</head>
<body>

  <canvas id="confetti-canvas"></canvas>

  <!-- 頂部航海標題列 -->
  <header class="header-bar">
    <div class="brand">
      <span class="brand-icon">🏴‍☠️⛵</span>
      <div>
        <div class="brand-title">海盜船長的「因數」藏寶圖</div>
        <div class="brand-sub">四年級數學｜右邊有專屬「航海草稿紙」可以手寫算除法直式喔！</div>
      </div>
    </div>
    <div class="header-right">
      <div class="gem-badge">
        <span>💎</span>
        <span><span id="gem-count">0</span> 顆藏寶石</span>
      </div>
      <button id="home-btn" class="home-btn" style="display:none;" onclick="backToMenu()">🗺️ 切換海域</button>
    </div>
  </header>

  <!-- 雙欄主工作區：左側題目作答 ＋ 右側手寫草稿紙 -->
  <div class="workspace-grid">
    <!-- 左側題目與鍵盤區 -->
    <main id="game-card" class="game-card"></main>

    <!-- 右側草稿書寫空間 -->
    <aside class="scratchpad-card">
      <div class="pad-header">
        <div class="pad-title">✍️ 航海草稿紙（計算區）</div>
        <div class="pad-tools">
          <button class="color-dot active" style="background:#1e293b;" onclick="setPenColor('#1e293b', this)" title="黑色畫筆"></button>
          <button class="color-dot" style="background:#0284c7;" onclick="setPenColor('#0284c7', this)" title="藍色畫筆"></button>
          <button class="color-dot" style="background:#e11d48;" onclick="setPenColor('#e11d48', this)" title="紅色畫筆"></button>
          <button id="eraser-btn" class="pad-btn" onclick="toggleEraser()">🧽 橡皮擦</button>
          <button class="pad-btn clear-pad" onclick="clearScratchpad()">🗑️ 清空</button>
        </div>
      </div>
      <div id="canvas-wrapper" class="canvas-wrapper">
        <canvas id="scratch-canvas"></canvas>
      </div>
      <div class="pad-tip">💡 提示：用滑鼠、觸控筆或手指在格子紙上列乘法或除法算式，找出所有因數！</div>
    </aside>
  </div>

  <script>
    // ==========================================
    // 1. 音效模組 (SoundFX)
    // ==========================================
    const SoundFX = {
      ctx: null,
      init() {
        if (!this.ctx) {
          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          if (AudioCtx) this.ctx = new AudioCtx();
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume().catch(() => {});
        }
      },
      playTone(freq, type, duration, delay = 0, vol = 0.14) {
        try {
          this.init();
          if (!this.ctx) return;
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = type;
          osc.frequency.setValueAtTime(freq, this.ctx.currentTime + delay);
          gain.gain.setValueAtTime(vol, this.ctx.currentTime + delay);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + delay + duration);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start(this.ctx.currentTime + delay);
          osc.stop(this.ctx.currentTime + delay + duration);
        } catch (e) {}
      },
      click() { this.playTone(620, 'sine', 0.08, 0, 0.12); },
      success() {
        this.playTone(523.25, 'triangle', 0.14, 0, 0.16);
        this.playTone(659.25, 'triangle', 0.14, 0.09, 0.16);
        this.playTone(783.99, 'triangle', 0.16, 0.18, 0.16);
        this.playTone(1046.5, 'triangle', 0.28, 0.27, 0.18);
      },
      wrong() {
        this.playTone(300, 'sine', 0.15, 0, 0.14);
        this.playTone(235, 'sine', 0.2, 0.13, 0.14);
      }
    };

    // ==========================================
    // 2. 慶祝彩帶模組 (Confetti)
    // ==========================================
    const Confetti = {
      particles: [],
      animId: null,
      launch() {
        const canvas = document.getElementById('confetti-canvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;

        const colors = ['#f59e0b', '#10b981', '#0284c7', '#f43f5e', '#a855f7'];
        for (let i = 0; i < 65; i++) {
          this.particles.push({
            x: Math.random() * canvas.width,
            y: -20 - Math.random() * 120,
            vx: (Math.random() - 0.5) * 6,
            vy: 3 + Math.random() * 5,
            size: 7 + Math.random() * 7,
            color: colors[Math.floor(Math.random() * colors.length)],
            rot: Math.random() * Math.PI * 2,
            vrot: (Math.random() - 0.5) * 0.2
          });
        }

        if (!this.animId) {
          const tick = () => {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            for (let i = this.particles.length - 1; i >= 0; i--) {
              const p = this.particles[i];
              p.x += p.vx;
              p.y += p.vy;
              p.vy += 0.14;
              p.rot += p.vrot;
              ctx.save();
              ctx.translate(p.x, p.y);
              ctx.rotate(p.rot);
              ctx.fillStyle = p.color;
              ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.6);
              ctx.restore();
              if (p.y > canvas.height + 30) {
                this.particles.splice(i, 1);
              }
            }
            if (this.particles.length > 0) {
              this.animId = requestAnimationFrame(tick);
            } else {
              this.animId = null;
            }
          };
          this.animId = requestAnimationFrame(tick);
        }
      }
    };

    // ==========================================
    // 3. 右側手寫草稿畫板 (Scratchpad Canvas)
    // ==========================================
    const Scratchpad = {
      canvas: null,
      ctx: null,
      drawing: false,
      color: '#1e293b',
      isEraser: false,
      lastX: 0,
      lastY: 0,

      init() {
        this.canvas = document.getElementById('scratch-canvas');
        const wrapper = document.getElementById('canvas-wrapper');
        if (!this.canvas || !wrapper) return;
        this.ctx = this.canvas.getContext('2d');

        const resizeCanvas = () => {
          const rect = wrapper.getBoundingClientRect();
          if (rect.width === 0 || rect.height === 0) return;
          // 保存現有筆跡
          const temp = document.createElement('canvas');
          temp.width = this.canvas.width;
          temp.height = this.canvas.height;
          if (temp.width > 0 && temp.height > 0) {
            temp.getContext('2d').drawImage(this.canvas, 0, 0);
          }

          this.canvas.width = rect.width;
          this.canvas.height = rect.height;
          this.ctx.lineCap = 'round';
          this.ctx.lineJoin = 'round';
          if (temp.width > 0 && temp.height > 0) {
            this.ctx.drawImage(temp, 0, 0);
          }
        };

        resizeCanvas();
        window.addEventListener('resize', resizeCanvas);

        const getPos = (e) => {
          const rect = this.canvas.getBoundingClientRect();
          const clientX = e.touches ? e.touches[0].clientX : e.clientX;
          const clientY = e.touches ? e.touches[0].clientY : e.clientY;
          return { x: clientX - rect.left, y: clientY - rect.top };
        };

        const startDraw = (e) => {
          e.preventDefault();
          this.drawing = true;
          const pos = getPos(e);
          this.lastX = pos.x;
          this.lastY = pos.y;
        };

        const moveDraw = (e) => {
          if (!this.drawing) return;
          e.preventDefault();
          const pos = getPos(e);
          this.ctx.beginPath();
          this.ctx.moveTo(this.lastX, this.lastY);
          this.ctx.lineTo(pos.x, pos.y);
          if (this.isEraser) {
            this.ctx.globalCompositeOperation = 'destination-out';
            this.ctx.lineWidth = 22;
          } else {
            this.ctx.globalCompositeOperation = 'source-over';
            this.ctx.strokeStyle = this.color;
            this.ctx.lineWidth = 3;
          }
          this.ctx.stroke();
          this.lastX = pos.x;
          this.lastY = pos.y;
        };

        const endDraw = () => {
          this.drawing = false;
        };

        this.canvas.addEventListener('mousedown', startDraw);
        this.canvas.addEventListener('mousemove', moveDraw);
        window.addEventListener('mouseup', endDraw);

        this.canvas.addEventListener('touchstart', startDraw, { passive: false });
        this.canvas.addEventListener('touchmove', moveDraw, { passive: false });
        window.addEventListener('touchend', endDraw);
      },

      clear() {
        if (!this.ctx || !this.canvas) return;
        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
      }
    };

    function setPenColor(hex, btnEl) {
      SoundFX.click();
      Scratchpad.isEraser = false;
      Scratchpad.color = hex;
      document.getElementById('eraser-btn').classList.remove('active');
      document.querySelectorAll('.color-dot').forEach(d => d.classList.remove('active'));
      if (btnEl) btnEl.classList.add('active');
    }

    function toggleEraser() {
      SoundFX.click();
      Scratchpad.isEraser = !Scratchpad.isEraser;
      const btn = document.getElementById('eraser-btn');
      if (Scratchpad.isEraser) {
        btn.classList.add('active');
        document.querySelectorAll('.color-dot').forEach(d => d.classList.remove('active'));
      } else {
        btn.classList.remove('active');
        const firstDot = document.querySelector('.color-dot');
        if (firstDot) firstDot.classList.add('active');
      }
    }

    function clearScratchpad() {
      SoundFX.click();
      Scratchpad.clear();
    }

    // ==========================================
    // 4. 因數題庫生成器（仿圖片格式：先寫出乘法算式成對，再由小到大列出所有因數）
    // ==========================================
    const POOL_EASY = [12, 14, 15, 16, 18, 20, 21, 22, 25, 27];
    const POOL_MID  = [24, 28, 30, 32, 36, 40, 42, 45, 48, 50];
    const POOL_HARD = [30, 36, 42, 48, 54, 56, 60, 64, 72, 84];

    function buildFactorQuestion(n) {
      // 找出所有乘法算式對 [a, b] 且 a <= b
      const pairs = [];
      const factors = [];
      for (let i = 1; i * i <= n; i++) {
        if (n % i === 0) {
          const j = n / i;
          pairs.push([i, j]);
          factors.push(i);
          if (i !== j) factors.push(j);
        }
      }
      factors.sort((a, b) => a - b);

      // 建立所有需要填寫的空格標準答案陣列：
      // 第一行：n = 1 × [n] -> 只需填右側 1 個空格
      // 其餘行：n = [a] × [b] -> 每行需填左右 2 個空格（從小到大排列）
      // 下方列舉區：n 的因數有 [f1]、[f2]、...、[fk]。
      const slotMeta = []; // { type: 'pairFirst' | 'pairLeft' | 'pairRight' | 'list', pairIdx, expected }
      slotMeta.push({ type: 'pairFirst', pairIdx: 0, expected: pairs[0][1] });
      for (let p = 1; p < pairs.length; p++) {
        slotMeta.push({ type: 'pairLeft', pairIdx: p, expected: pairs[p][0] });
        slotMeta.push({ type: 'pairRight', pairIdx: p, expected: pairs[p][1] });
      }
      for (let f = 0; f < factors.length; f++) {
        slotMeta.push({ type: 'list', listIdx: f, expected: factors[f] });
      }

      return { n, pairs, factors, slotMeta };
    }

    const TOTAL_QUESTIONS = 5;
    let currentLevel = null; // 'easy' | 'mid' | 'hard'
    let questions = [];
    let qIndex = 0;
    let totalGems = 0;
    let userInputs = [];
    let activeSlot = 0;
    let feedback = null; // null | 'correct' | 'wrong'
    let showResult = false;

    function shuffle(arr) {
      const copy = [...arr];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    }

    function startLevel(lvl) {
      SoundFX.click();
      currentLevel = lvl;
      const pool = lvl === 'easy' ? POOL_EASY : (lvl === 'mid' ? POOL_MID : POOL_HARD);
      const picked = shuffle(pool).slice(0, TOTAL_QUESTIONS);
      questions = picked.map(n => buildFactorQuestion(n));
      qIndex = 0;
      initQuestionState();
      showResult = false;
      Scratchpad.clear();
      document.getElementById('home-btn').style.display = 'inline-block';
      renderScreen();
    }

    function initQuestionState() {
      const q = questions[qIndex];
      userInputs = q.slotMeta.map(() => '');
      activeSlot = 0;
      feedback = null;
    }

    function backToMenu() {
      SoundFX.click();
      currentLevel = null;
      showResult = false;
      document.getElementById('home-btn').style.display = 'none';
      renderScreen();
    }

    function selectSlot(idx) {
      if (feedback === 'correct') return;
      SoundFX.click();
      activeSlot = idx;
      if (feedback === 'wrong') feedback = null;
      updateSlotsUI(false);
    }

    // ==========================================
    // 5. 渲染左側題目舞台
    // ==========================================
    function renderScreen() {
      document.getElementById('gem-count').textContent = totalGems;
      const card = document.getElementById('game-card');

      // 1. 關卡選擇畫面
      if (!currentLevel) {
        card.innerHTML = `
          <div class="menu-screen">
            <div style="font-size: 56px; line-height: 1;">🏴‍☠️🗺️💎</div>
            <h2 style="font-size: 24px; font-weight: 900; color: #78350f;">準備好尋找「因數」寶藏了嗎？</h2>
            <p style="font-size: 14px; font-weight: 700; color: #64748b;">
              先用乘法算式成對找出因數，再由小到大全部列出來！右邊草稿紙隨時可以寫算式喔！
            </p>

            <div class="mode-grid">
              <button class="mode-card m-easy" onclick="startLevel('easy')">
                <div class="mode-title">🏝️ 浅海尋寶島（入門：12 ～ 27）</div>
                <div class="mode-desc">練習基本九九乘法表內的因數分解（如 12、18、20）</div>
              </button>

              <button class="mode-card m-mid" onclick="startLevel('mid')">
                <div class="mode-title">⛵ 珊瑚迷霧海（標準：24 ～ 50，含例題 30）</div>
                <div class="mode-desc">挑戰課本經典題型（如找出 30、36、48 的所有因數）</div>
              </button>

              <button class="mode-card m-hard" onclick="startLevel('hard')">
                <div class="mode-title">👑 傳說黑珍珠號（進階：30 ～ 84）</div>
                <div class="mode-desc">善用右邊草稿紙列除法直式，找出較大數字的所有因數！</div>
              </button>
            </div>
          </div>
        `;
        return;
      }

      // 2. 結算畫面
      if (showResult) {
        card.innerHTML = `
          <div class="result-box">
            <div style="font-size: 60px;">🏆🏴‍☠️💎✨</div>
            <h2 style="font-size: 26px; font-weight: 900; color: #78350f;">尋寶成功！你是「因數」大船長！</h2>
            <p style="font-size: 16px; font-weight: 800; color: #475569;">
              你已經成功收集了 <strong style="color:#d97706;font-size:24px;">${totalGems}</strong> 顆藏寶石！
            </p>
            <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:10px;">
              <button class="action-pill-btn" onclick="startLevel('${currentLevel}')">🔄 再挑戰同海域</button>
              <button class="action-pill-btn secondary" onclick="backToMenu()">🗺️ 選擇其他海域</button>
            </div>
          </div>
        `;
        return;
      }

      // 3. 進行中的題目畫面（還原參考圖片結構）
      const q = questions[qIndex];
      const dotsHTML = Array.from({ length: TOTAL_QUESTIONS }, (_, i) => {
        const cls = i < qIndex ? 'done' : (i === qIndex ? 'current' : '');
        return `<span class="p-dot ${cls}"></span>`;
      }).join('');

      // 組合淡黃色乘法算式卡片的 HTML
      let slotCounter = 0;
      let multRowsHTML = `
        <div class="mult-row">
          <span class="fixed-num">${q.n}</span>
          <span>＝</span>
          <span class="fixed-num">1</span>
          <span>×</span>
          <span id="slot-${slotCounter}" class="blank-box ${slotCounter === activeSlot ? 'active' : ''}" onclick="selectSlot(${slotCounter})"></span>
        </div>
      `;
      slotCounter++;

      for (let p = 1; p < q.pairs.length; p++) {
        const leftIdx = slotCounter++;
        const rightIdx = slotCounter++;
        multRowsHTML += `
          <div class="mult-row">
            <span class="fixed-num">${q.n}</span>
            <span>＝</span>
            <span id="slot-${leftIdx}" class="blank-box ${leftIdx === activeSlot ? 'active' : ''}" onclick="selectSlot(${leftIdx})"></span>
            <span>×</span>
            <span id="slot-${rightIdx}" class="blank-box ${rightIdx === activeSlot ? 'active' : ''}" onclick="selectSlot(${rightIdx})"></span>
          </div>
        `;
      }

      // 組合下方「n 的因數有 [ ]、[ ]、...。」的 HTML
      let listHTML = `<span>${q.n} 的因數有</span>`;
      for (let f = 0; f < q.factors.length; f++) {
        const idx = slotCounter++;
        listHTML += `<span id="slot-${idx}" class="blank-box ${idx === activeSlot ? 'active' : ''}" onclick="selectSlot(${idx})"></span>`;
        listHTML += f < q.factors.length - 1 ? `<span>、</span>` : `<span>。</span>`;
      }

      card.innerHTML = `
        <div style="display:flex; flex-direction:column; gap:12px;">
          <div class="stage-header">
            <span class="stage-badge">⛵ 藏寶關卡 第 ${qIndex + 1} / ${TOTAL_QUESTIONS} 題</span>
            <div class="progress-dots">${dotsHTML}</div>
          </div>

          <div class="q-title-row">
            <span class="num-circle">${qIndex + 1}</span>
            <span>找出 ${q.n} 的因數。</span>
          </div>

          <div class="factor-work-area">
            <!-- 淡黃色乘法算式框（完全仿照圖片） -->
            <div class="mult-pairs-card">
              ${multRowsHTML}
            </div>

            <!-- 緊貼右側的迷你數字鍵盤 -->
            <div id="mini-keypad" class="mini-keypad">
              <div class="keypad-top">
                <span class="keypad-label">🔢 數字鍵盤</span>
              </div>
              <div class="keypad-grid">
                ${[1, 2, 3, 4, 5, 6, 7, 8, 9, 0].map(n => `
                  <button class="key-btn" onclick="pressDigit(${n})">${n}</button>
                `).join('')}
              </div>
              <div class="keypad-actions">
                <button class="key-clear" onclick="clearDigit()">⌫ 清除</button>
                <button class="key-submit" onclick="handleConfirm()">確定 ✓</button>
              </div>
            </div>
          </div>

          <!-- 下方列出所有因數 -->
          <div class="list-factors-box">
            <div class="list-factors-flow">${listHTML}</div>
          </div>
        </div>

        <div style="display:flex; flex-direction:column; gap:8px;">
          <div class="helper-bar">
            💡 填寫順序提示：上面的乘法算式請依序從小到大找（1×、2×、3×...），下方則由小到大列出 ${q.n} 的全部 ${q.factors.length} 個因數！
          </div>
          <div id="feedback-container" style="width: 100%;"></div>
        </div>
      `;
    }

    // ==========================================
    // 6. 無閃動局部更新空格與回饋橫幅
    // ==========================================
    function updateSlotsUI(animateWrong = false) {
      const q = questions[qIndex];
      const pad = document.getElementById('mini-keypad');
      const fbContainer = document.getElementById('feedback-container');

      for (let i = 0; i < q.slotMeta.length; i++) {
        const el = document.getElementById(`slot-${i}`);
        if (!el) continue;

        el.className = 'blank-box';
        if (feedback === 'correct') {
          el.classList.add('correct');
        } else if (feedback === 'wrong') {
          const val = userInputs[i];
          if (val === '' || parseInt(val, 10) !== q.slotMeta[i].expected) {
            el.classList.add('wrong');
            if (animateWrong) {
              el.style.animation = 'none';
              void el.offsetWidth;
              el.style.animation = 'shakeSide 0.4s ease';
            }
          } else {
            el.classList.add('correct');
          }
        } else if (i === activeSlot) {
          el.classList.add('active');
        }

        el.textContent = userInputs[i];
      }

      if (pad) {
        pad.style.display = feedback === 'correct' ? 'none' : 'block';
      }

      if (!fbContainer) return;
      if (feedback === 'wrong') {
        fbContainer.innerHTML = `
          <div class="feedback-banner wrong">
            <span>⚠️ 紅色框框的數字還不對喔！請檢查乘法算式是否由小到大排列，並確保下方因數沒有漏掉！</span>
          </div>
        `;
      } else if (feedback === 'correct') {
        const nextText = qIndex < TOTAL_QUESTIONS - 1 ? '下一題 ➔' : '打開寶藏箱 🏆';
        fbContainer.innerHTML = `
          <div class="feedback-banner correct">
            <span>🎉 完全正確！${q.n} 的因數有 ${q.factors.join('、')}（＋1 顆藏寶石 💎）</span>
            <button class="next-btn" onclick="goNext()">${nextText}</button>
          </div>
        `;
      } else {
        fbContainer.innerHTML = '';
      }
    }

    // ==========================================
    // 7. 迷你鍵盤數字輸入（支援兩位數）
    // ==========================================
    function pressDigit(num) {
      if (feedback === 'correct') return;
      SoundFX.click();

      if (feedback === 'wrong') {
        feedback = null;
        userInputs[activeSlot] = String(num);
        updateSlotsUI(false);
        return;
      }

      const cur = userInputs[activeSlot];
      if (cur === '' || cur === '0') {
        userInputs[activeSlot] = String(num);
      } else if (cur.length < 2) {
        userInputs[activeSlot] = cur + String(num);
      } else {
        userInputs[activeSlot] = String(num);
      }
      updateSlotsUI(false);
    }

    function clearDigit() {
      if (feedback === 'correct') return;
      SoundFX.click();
      userInputs[activeSlot] = '';
      feedback = null;
      updateSlotsUI(false);
    }

    function handleConfirm() {
      if (feedback === 'correct') return;
      const q = questions[qIndex];

      if (userInputs[activeSlot] === '') {
        SoundFX.wrong();
        const pad = document.getElementById('mini-keypad');
        if (pad) {
          pad.style.animation = 'none';
          void pad.offsetWidth;
          pad.style.animation = 'shakeSide 0.4s ease';
        }
        return;
      }

      // 還有空白格時，按「確定 ✓」自動跳到下一個空白格
      const nextEmpty = userInputs.findIndex(v => v === '');
      if (nextEmpty !== -1) {
        SoundFX.click();
        activeSlot = nextEmpty;
        updateSlotsUI(false);
        return;
      }

      // 全部空格填滿後進行檢查
      const allCorrect = q.slotMeta.every((meta, idx) => parseInt(userInputs[idx], 10) === meta.expected);

      if (allCorrect) {
        feedback = 'correct';
        totalGems += 1;
        document.getElementById('gem-count').textContent = totalGems;
        SoundFX.success();
        Confetti.launch();
      } else {
        feedback = 'wrong';
        const firstWrong = q.slotMeta.findIndex((meta, idx) => parseInt(userInputs[idx], 10) !== meta.expected);
        if (firstWrong !== -1) activeSlot = firstWrong;
        SoundFX.wrong();
      }
      updateSlotsUI(true);
    }

    function goNext() {
      SoundFX.click();
      if (qIndex < TOTAL_QUESTIONS - 1) {
        qIndex += 1;
        initQuestionState();
        Scratchpad.clear();
        renderScreen();
      } else {
        showResult = true;
        SoundFX.success();
        Confetti.launch();
        renderScreen();
      }
    }

    // 支援電腦實體鍵盤輸入
    window.addEventListener('keydown', (e) => {
      if (!currentLevel || showResult) return;
      if (e.key >= '0' && e.key <= '9') {
        pressDigit(parseInt(e.key, 10));
      } else if (e.key === 'Backspace' || e.key === 'Delete') {
        clearDigit();
      } else if (e.key === 'Enter') {
        if (feedback === 'correct') goNext();
        else handleConfirm();
      }
    });

    // 初始化首頁與右側草稿紙
    renderScreen();
    Scratchpad.init();
  </script>
</body>
</html>
